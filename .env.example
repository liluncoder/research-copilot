# ============ LLM（至少配一个 provider）============
# 主 provider：deepseek / zhipu / dashscope 三选一
LLM_PROVIDER=deepseek

# DeepSeek（platform.deepseek.com 申请，按量付费）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 智谱 GLM（open.bigmodel.cn，有免费额度，兜底用）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/paas/v4
ZHIPU_MODEL=glm-4-plus

# 通义千问（dashscope.aliyun.com，有免费额度，兜底用）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# ============ 本地模型（无 key，CPU 可跑）============
# BGE-M3 embedding（首次运行自动从 HuggingFace 下载，约 2GB）
EMBEDDING_MODEL=BAAI/bge-m3
# PaddleOCR 语言（扫描件用例）
OCR_LANG=ch

# ============ 存储路径 ============
CHROMA_PERSIST_DIR=./chroma_data
UPLOAD_DIR=./data/uploads

# ============ 服务端口 ============
BACKEND_PORT=8000
# 前端访问后端的地址（Docker 内部通信时改为 http://backend:8000）
NEXT_PUBLIC_API_URL=http://localhost:8000
