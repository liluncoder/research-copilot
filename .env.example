# ============ LLM（至少配一个 provider）============
# 主 provider：deepseek / zhipu / dashscope 三选一
LLM_PROVIDER=deepseek

# DeepSeek（platform.deepseek.com 申请，按量付费）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 智谱 GLM：GLM-4-Flash 目前**永久免费**（128K 上下文，有速率限制），适合演示与自测
# ★base_url 必须带 /api：少这一层会返回 405（nginx 拦在网关外，到不了模型）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# 通义千问（dashscope.aliyun.com，有免费额度，兜底用）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# ============ 本地模型（无 key，CPU 可跑）============
# BGE-M3 embedding（约 2.2GB）。国内建议先跑 backend/tools/fetch_models.py 下到本地
EMBEDDING_MODEL=BAAI/bge-m3
# 模型所在目录（可选）。指向 fetch_models.py 下好的目录即可离线/加速启动
# BGE_M3_PATH=C:/Users/<你>/.cache/bge-m3
# 向量后端：auto=有 BGE-M3 就用、没有退离线 hash；也可强制 bge-m3 / hash
EMBEDDING_BACKEND=auto
# PaddleOCR 语言（扫描件用例）
OCR_LANG=ch

# ============ 检索参数（S2）============
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5

# ============ 存储路径 ============
CHROMA_PERSIST_DIR=./chroma_data
UPLOAD_DIR=./data/uploads
# 向量索引后端：auto=装了 chromadb 就用、否则 numpy；numpy=强制读 <doc>/vectors.npy
# ★HF 单容器必须 numpy（预置索引是 numpy 格式，镜像里又带着 chromadb）
# STORE_BACKEND=numpy

# ============ 服务端口 ============
BACKEND_PORT=8000
# 前端访问后端的地址（Docker 内部通信时改为 http://backend:8000）
NEXT_PUBLIC_API_URL=http://localhost:8000
