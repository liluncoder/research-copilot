node_modules/
__pycache__/
*.pyc
.venv/
venv/

# 环境与密钥（★只进环境变量，见 .env.example）
# ★用 .env.* 一次兜住所有变体（.env.local / .env.bak / .env.production …）。
#   原来只写了 .env.local 和 .env.*.local，漏掉了 .env.bak ——
#   而"备份 .env"恰恰是密钥最容易泄露进仓库的路径。
.env
.env.*
!.env.example

# 构建产物
.next/
out/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/

# 大文件与本地数据（模型权重 / 向量库 / 上传件）
*.bin
*.npz
chroma_data/
data/uploads/

# 系统杂项
Thumbs.db
desktop.ini

# 仓库根目录的临时文件（调试日志/中间产物，一律不进仓库）
# ★必须写成 /_* 而不是 _*：后者会把子目录里所有以下划线开头的文件一起屏蔽，
#   包括 Python 的 __init__.py（首次踩到：backend/app/services/__init__.py 静默没进仓库）
/_*
*.log
